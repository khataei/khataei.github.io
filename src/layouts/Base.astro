---
import '../styles/global.css';
const { title = 'Javad Khataei — Data science & applied machine learning', description = 'Javad Khataei is a Senior Data Scientist at CARFAX Canada, responsible for vehicle valuation. Production machine learning, language models, and technical writing.' } = Astro.props;
const path = Astro.url.pathname;
const links = [{href:'/',label:'Home'},{href:'/about/',label:'About'},{href:'/work/',label:'Work'},{href:'/research/',label:'Research'},{href:'/writing/',label:'Writing'}];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Javad Khataei — Writing" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <script is:inline>
      try { const saved = localStorage.getItem('theme'); if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved; } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a href="/" class="wordmark" aria-label="Javad Khataei, home">Javad Khataei<span class="wordmark-dot">.</span></a>
      <div class="header-actions">
        <nav class="desktop-nav" aria-label="Main navigation">{links.map(link => <a href={link.href} aria-current={path === link.href ? 'page' : undefined}>{link.label}</a>)}</nav>
        <button id="theme-toggle" class="theme-toggle" aria-label="Switch color theme" title="Switch color theme">
          <svg class="sun" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
          <svg class="moon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20.5 14A8.5 8.5 0 0 1 10 3.5 8.5 8.5 0 1 0 20.5 14Z"/></svg>
        </button>
        <details class="mobile-nav"><summary>Menu <span aria-hidden="true">+</span></summary><nav aria-label="Mobile navigation">{links.map(link => <a href={link.href} aria-current={path === link.href ? 'page' : undefined}>{link.label}</a>)}</nav></details>
      </div>
    </header>
    <main id="main" class="wrap"><slot /></main>
    <footer class="site-footer wrap">
      <div><a class="footer-name" href="/">Javad Khataei</a><p>Data science, machine learning, and technical notes.</p></div>
      <div class="footer-links"><a href="https://www.linkedin.com/in/khataei/">LinkedIn <span aria-hidden="true">↗</span></a><a href="https://github.com/khataei">GitHub <span aria-hidden="true">↗</span></a><a href="/rss.xml">RSS <span aria-hidden="true">↗</span></a></div>
      <span class="copyright">© {new Date().getFullYear()} Javad Khataei</span>
    </footer>
    <script>
      const button = document.getElementById('theme-toggle');
      const system = window.matchMedia('(prefers-color-scheme: dark)');
      function isDark() { return document.documentElement.dataset.theme ? document.documentElement.dataset.theme === 'dark' : system.matches; }
      function updateLabel() { button?.setAttribute('aria-label', `Switch to ${isDark() ? 'light' : 'dark'} mode`); button?.setAttribute('title', `Switch to ${isDark() ? 'light' : 'dark'} mode`); }
      updateLabel();
      system.addEventListener('change', updateLabel);
      button?.addEventListener('click', () => { const next = isDark() ? 'light' : 'dark'; document.documentElement.dataset.theme = next; try { localStorage.setItem('theme', next); } catch {} updateLabel(); });
    </script>
  </body>
</html>
