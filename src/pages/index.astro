---
import Base from '../layouts/Base.astro';
import GitHubStats from '../components/GitHubStats.astro';
const allPosts = Object.values(import.meta.glob('./writing/*.md', { eager: true })) as any[];
const latestPosts = allPosts.filter(post => !post.frontmatter.draft).sort((a,b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime()).slice(0,3);
---
<Base>
  <section class="hero">
    <span class="eyebrow">Data science & applied machine learning</span>
    <h1>Javad Khataei</h1>
    <p class="intro">Senior Data Scientist at <strong>CARFAX Canada</strong>, responsible for the vehicle valuation model used by dealers and consumers across Canada.</p>
    <div class="hero-bottom"><div class="hero-links"><a class="text-link" href="/work/">My work <span aria-hidden="true">↗</span></a><a class="text-link" href="#github">GitHub activity <span aria-hidden="true">↓</span></a></div><span class="location">Based in Greater Vancouver, Canada</span></div>
  </section>
  <section class="valuation-feature" aria-labelledby="valuation-title">
    <div>
      <span class="eyebrow">Current work / CARFAX Canada</span>
      <h2 id="valuation-title">Vehicle valuation.<br />Market data and vehicle history.</h2>
      <p>My work covers the valuation model and its deployment: estimating vehicle prices from vehicle attributes, market conditions, and individual vehicle history.</p>
      <p>History-Based Value accounts for prior damage, service records, ownership, and vehicle use to produce a value specific to a vehicle’s VIN.</p>
      <a class="text-link" href="/work/#carfax">More about my role <span aria-hidden="true">↗</span></a>
    </div>
    <aside class="valuation-aside" aria-labelledby="valuation-use-title">
      <h3 id="valuation-use-title">Where CARFAX Canada values are used</h3>
      <ul>
        <li><a href="https://www.carfax.ca/media/carfax-canada-and-kijiji-partner-to-deliver-improved-vehicle-valuations">Kijiji <span aria-hidden="true">↗</span></a><p>Market-price comparisons and deal ratings on vehicle listings.</p></li>
        <li><a href="https://www.carfax.ca/media/autoverify-and-carfax-canada-partner-to-bring-more-accurate-vehicle-valuations-to-dealers-and-car-shoppers">AutoVerify <span aria-hidden="true">↗</span></a><p>Trade-in estimates on dealer websites and the Kijiji marketplace.</p></li>
        <li><a href="https://go.carfax.ca/valuation-suite">Valuation Suite <span aria-hidden="true">↗</span></a><p>Market-based and history-based retail, wholesale, and listing values for dealers.</p></li>
      </ul>
    </aside>
  </section>
  <section class="section" aria-labelledby="focus-title">
    <div class="section-heading"><h2 id="focus-title">What I work on</h2><a href="/work/">Experience <span aria-hidden="true">↗</span></a></div>
    <div class="feature-grid">
      <article class="feature"><span class="number">01 /</span><h3>Valuation<br />models</h3><p>Leading model development and evaluation for vehicle pricing, including improvements using LightGBM.</p><span class="category">Prediction · Evaluation</span></article>
      <article class="feature"><span class="number">02 /</span><h3>Production<br />ML systems</h3><p>Optimizing prediction APIs for low latency and concurrent requests, and deploying models on Azure.</p><span class="category">Inference · MLOps</span></article>
      <article class="feature"><span class="number">03 /</span><h3>Language<br />models</h3><p>Leading LLM work on information extraction, summarization, and natural language interfaces for data.</p><span class="category">LLMs · NLP · RAG</span></article>
    </div>
  </section>
  <section class="section" aria-labelledby="writing-title"><div class="section-heading"><h2 id="writing-title">Notes & writing</h2><a href="/writing/">All writing <span aria-hidden="true">↗</span></a></div>{latestPosts.length ? latestPosts.map(post => <article class="record"><span class="meta">{new Date(post.frontmatter.date).toLocaleDateString('en-CA',{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'})}</span><h3 class="paper-title"><a href={post.url}>{post.frontmatter.title}</a></h3><p>{post.frontmatter.description}</p></article>) : <div class="writing-row"><div><h3>Technical notes.</h3><p>Notes on machine learning, software, and problems I’m working through. Articles will appear here as I publish them.</p></div><span class="writing-mark" aria-hidden="true">↗</span></div>}</section>
  <GitHubStats />
</Base>
