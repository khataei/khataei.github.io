---
import Base from '../../layouts/Base.astro';
const allPosts = Object.values(import.meta.glob('./*.md', { eager: true })) as any[];
const posts = allPosts.filter(post => !post.frontmatter.draft).sort((a,b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());
---
<Base title="Writing — Javad Khataei" description="Notes on machine learning, research, and things learned along the way by Javad Khataei.">
  <div class="page-heading"><span class="eyebrow">Writing</span><h1>Notes along<br />the way.</h1><p>A space for what I'm learning, problems I'm exploring, and ideas I want to return to.</p></div>
  {posts.length ? <section class="section" aria-label="Posts">{posts.map(post => <article class="record"><span class="meta">{new Date(post.frontmatter.date).toLocaleDateString('en-CA',{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'})}</span><h2 class="paper-title"><a href={post.url}>{post.frontmatter.title}</a></h2><p>{post.frontmatter.description}</p></article>)}</section> : <section class="empty-writing"><h2>The notebook is open.</h2><p>No published posts yet. Future notes will live here, covering machine learning, research, and interesting things learned along the way.</p><a class="text-link" href="/research/">In the meantime, explore my research <span aria-hidden="true">↗</span></a></section>}
</Base>
